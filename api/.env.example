# Подключение к Postgres.
# Локально — см. README (brew или Docker). На Railway переменная
# подставляется автоматически при добавлении Postgres к проекту.
DATABASE_URL="postgresql://tutor:tutor@localhost:5432/tutor_crm?schema=public"

# Токен бота из @BotFather. Им же проверяется подпись initData,
# поэтому без него API не поднимется.
BOT_TOKEN=""

# Имя бота без @ — для ссылок-приглашений.
BOT_USERNAME="your_tutor_bot"

# Секрет подписи JWT. Сгенерировать: openssl rand -base64 32
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# Origin мини-аппа для CORS. Несколько — через запятую.
CORS_ORIGINS="http://localhost:5173"

PORT=3000
# Сколько прокси стоит перед API на хостинге (обычно 1). Локально — не задавать.
TRUST_PROXY=
NODE_ENV=development

# Режим бота:
# polling — локально с работающим ботом, webhook — прод,
# off — бот не подключается к Telegram (разработка интерфейса: не отбирает
# обновления у продового бота с тем же токеном и никому не пишет).
BOT_MODE="polling"

# Только для webhook: публичный адрес API, например https://api.example.com
# Telegram будет слать обновления на <BOT_PUBLIC_URL>/api/bot/webhook
BOT_PUBLIC_URL=""

# Только для webhook: секрет в заголовке X-Telegram-Bot-Api-Secret-Token.
# Без него webhook-эндпоинт принимает запросы от кого угодно.
# Сгенерировать: openssl rand -hex 32
BOT_WEBHOOK_SECRET=""

# ИИ для материалов урока (теория + домашка в PDF).
# Любой OpenAI-совместимый API; по умолчанию OpenRouter.
# Ключ: https://openrouter.ai/keys. Без ключа материалы собираются
# из шаблона-заглушки — интерфейс можно смотреть и без него.
AI_API_KEY=""
AI_BASE_URL="https://openrouter.ai/api/v1"
# Модель. openai/gpt-6-luna — платная, около 0,2 цента за материал;
# на ключе OpenRouter должен быть баланс.
# Бесплатные модели — с суффиксом :free, ошибаются заметно чаще:
# https://openrouter.ai/models?max_price=0
AI_MODEL="openai/gpt-6-luna"
# Сколько модель рассуждает перед ответом: low, medium, high или none
# (none — не просить рассуждений вовсе). Пусто — high.
# Claude ниже high пишет задания с ошибками; у других моделей подбирать отдельно.
AI_REASONING_EFFORT="high"
# Кто проверяет теорию. Проверяющий должен быть сильнее автора: своих ошибок
# автор не видит. Пусто — та же модель и тот же уровень, что у генерации.
AI_CHECK_MODEL="anthropic/claude-sonnet-5.5"
AI_CHECK_EFFORT="high"
# Кто читает расписание с фото (импорт расписания). Модель должна принимать
# картинки. Пусто — AI_MODEL.
AI_IMPORT_MODEL=""

# Статистика пилота. Telegram ID администратора (число; узнать — бот @userinfobot):
# команда /stats в боте и фидбэк репетиторов приходят только ему.
ADMIN_TG_ID=""
# Сколько материалов ИИ соберёт одному репетитору за всё время,
# считая повторные сборки. Пусто — без лимита.
AI_MATERIALS_LIMIT=""
