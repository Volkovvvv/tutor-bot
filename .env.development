# Только для `npm run dev` — перекрывает .env. В сборку не попадает.
# Фронт ходит в локальный API (api/: npm run start:dev), а не в прод.
VITE_API_URL=http://localhost:3001/api

# Тестовый репетитор для входа без Telegram (см. tools/vite-dev-telegram-login.js).
# Свои значения — в .env.development.local, он не коммитится.
DEV_TG_USER_ID=100000001
DEV_TG_FIRST_NAME=Dev
DEV_TG_USERNAME=dev_tutor
